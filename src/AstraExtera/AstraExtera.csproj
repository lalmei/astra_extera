<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AstraExtera</AssemblyName>
    <RootNamespace>AstraExtera</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <VintageStoryPath Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">/Applications/Vintage Story.app</VintageStoryPath>
  </PropertyGroup>

  <!--
    AstraTerra is a hard dependency, so we compile against it to hand it the procedural star
    catalog. Prefer a sibling source checkout so the two evolve together during development, and
    fall back to the installed mod.
  -->
  <PropertyGroup>
    <AstraTerraPath Condition="'$(ASTRA_TERRA)' != ''">$(ASTRA_TERRA)</AstraTerraPath>
    <AstraTerraSiblingPath>$(MSBuildThisFileDirectory)../../../astra_terra/src/AstraTerra/bin/$(Configuration)/$(TargetFramework)</AstraTerraSiblingPath>
    <AstraTerraPath Condition="'$(AstraTerraPath)' == '' And Exists('$(AstraTerraSiblingPath)/AstraTerra.dll')">$(AstraTerraSiblingPath)</AstraTerraPath>
    <AstraTerraPath Condition="'$(AstraTerraPath)' == ''">$(HOME)/Library/Application Support/VintagestoryData/Mods/AstraTerra</AstraTerraPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The GUI toolkit hands custom-draw callbacks a Cairo context, so the galaxy panel needs it. -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VintageStoryPath)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Never copied locally: the game loads AstraTerra as its own mod. -->
    <Reference Include="AstraTerra">
      <HintPath>$(AstraTerraPath)/AstraTerra.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\modinfo.json">
      <Link>modinfo.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
